---
import EstimatePage from "../components/pages/EstimatePage";
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Estimer une livraison — Livro Cotonou et environs";
const description = "Préparez votre demande de devis de livraison avec Livro. Choisissez le quartier de départ et d’arrivée à Cotonou et Abomey-Calavi.";
---
<SiteLayout title={title} description={description} path="estimation/">
  <EstimatePage client:load />
</SiteLayout>
